# Copy this file to .env and edit the values. Never commit .env.
PORT=5000
# Local MongoDB (inspect with Compass at the same URI):
MONGODB_URI=mongodb://127.0.0.1:27017/shelf
# Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shelf?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
